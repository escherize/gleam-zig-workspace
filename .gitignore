# Sibling repositories with their own remotes
/gleam/
/gleam-stdlib/
/simplifile/
/argv/
/envoy/
/gleam_native/

# Vendored toolchain (fetch per README) and upstream tour clone
/toolchain/
/tour/

# Harness scratch project and build output
/examples/_run/
/examples/*/build/
.private/
.private-remote
.playwright-cli/

# Generated into the committed raytracer build tree by any zig-target build.
# The tree itself is committed on purpose (it is the shipped emitted-code
# sample); these are per-build cache files that are not.
examples/demo/raytracer/build/prod/zig/.prelude-*
examples/demo/raytracer/build/prod/zig/entrypoint@*.zig
.harness.lock
